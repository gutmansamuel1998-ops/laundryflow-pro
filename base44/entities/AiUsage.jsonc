{
  "name": "AiUsage",
  "type": "object",
  "description": "Server-only usage rows for the per-user AI budget. One row per paid AI request, written before the request is allowed to run and removed again if the request is refused or never reaches the model. Rows older than 30 days are deleted. Never read or written from the browser (all client access is blocked; functions use the service role).",
  "properties": {
    "user_id": {
      "description": "The signed-in user the request was made for",
      "type": "string"
    },
    "day": {
      "description": "UTC day, YYYY-MM-DD",
      "type": "string"
    },
    "ts": {
      "description": "Request time in milliseconds since 1970 (used for the per-minute limit)",
      "type": "number"
    },
    "op": {
      "description": "Which AI operation or function made the request",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "day"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
