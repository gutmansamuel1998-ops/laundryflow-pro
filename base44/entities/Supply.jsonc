{
  "name": "Supply",
  "properties": {
    "current_level": {
      "default": 100,
      "description": "Current supply level as percentage (0-100)",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "description": {
      "description": "Optional description of this supply item (up to 1000 characters)",
      "type": "string"
    },
    "estimated_days_remaining": {
      "description": "Calculated estimate of days until supply runs out",
      "type": "number"
    },
    "last_restocked": {
      "description": "When the supply was last restocked",
      "format": "date-time",
      "type": "string"
    },
    "low_threshold": {
      "default": 20,
      "description": "Percentage threshold for low supply notification",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "name": {
      "description": "Supply item name (e.g. Detergent, Fabric Softener)",
      "type": "string"
    },
    "notified_low": {
      "default": false,
      "description": "Whether low notification has been sent",
      "type": "boolean"
    },
    "unit": {
      "default": "loads",
      "description": "Unit of measurement",
      "enum": [
        "loads",
        "ml",
        "oz",
        "cups",
        "scoops"
      ],
      "type": "string"
    },
    "usage_history": {
      "description": "Historical tracking of supply levels for usage estimation",
      "items": {
        "properties": {
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "level": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "name",
    "current_level"
  ],
  "rls": {
    "create": true,
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}