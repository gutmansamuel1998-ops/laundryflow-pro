{
  "name": "Load",
  "properties": {
    "completed_at": {
      "description": "When the load was completed",
      "format": "date-time",
      "type": "string"
    },
    "current_state": {
      "default": "load_created",
      "description": "Current state of the load",
      "enum": [
        "load_created",
        "washing",
        "wash_finished",
        "drying",
        "dry_finished",
        "completed",
        "abandoned"
      ],
      "type": "string"
    },
    "dry_complete_notified": {
      "default": false,
      "description": "Whether dry complete email has been sent",
      "type": "boolean"
    },
    "dry_guidance": {
      "description": "Recommended drying method",
      "enum": [
        "tumble_low",
        "tumble_medium",
        "hang_dry"
      ],
      "type": "string"
    },
    "dry_timer_minutes": {
      "default": 45,
      "description": "Dry cycle duration in minutes",
      "type": "number"
    },
    "friction_detected": {
      "default": false,
      "description": "Whether friction has been detected for this load",
      "type": "boolean"
    },
    "friction_type": {
      "description": "Type of friction detected",
      "enum": [
        "abandoned_at_transfer",
        "prolonged_idle",
        "never_started",
        "none"
      ],
      "type": "string"
    },
    "household_members": {
      "description": "Optional household member names this load is for (Family profile only)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "idle_notified": {
      "default": false,
      "description": "Whether idle alert email has been sent",
      "type": "boolean"
    },
    "load_type": {
      "description": "Type of laundry load",
      "enum": [
        "everyday_clothes",
        "towels",
        "bedding",
        "delicates",
        "mixed"
      ],
      "type": "string"
    },
    "notes": {
      "description": "Optional notes about this load",
      "type": "string"
    },
    "stage_start_time": {
      "description": "When the current stage started",
      "format": "date-time",
      "type": "string"
    },
    "state_history": {
      "description": "Chronological record of state transitions",
      "items": {
        "properties": {
          "entered_at": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "completed",
        "abandoned"
      ],
      "type": "string"
    },
    "wash_complete_notified": {
      "default": false,
      "description": "Whether wash complete email has been sent",
      "type": "boolean"
    },
    "wash_guidance": {
      "description": "Recommended water temperature",
      "enum": [
        "cold",
        "warm",
        "hot"
      ],
      "type": "string"
    },
    "wash_timer_minutes": {
      "default": 35,
      "description": "Wash cycle duration in minutes",
      "type": "number"
    }
  },
  "required": [
    "load_type",
    "current_state",
    "status"
  ],
  "rls": {
    "create": true,
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}