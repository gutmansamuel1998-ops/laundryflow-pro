{
  "name": "User",
  "properties": {
    "alert_channels": {
      "type": "object"
    },
    "dyslexia_font": {
      "default": false,
      "type": "boolean"
    },
    "enable_laundry_reminders": {
      "default": true,
      "type": "boolean"
    },
    "enable_supply_alerts": {
      "default": true,
      "type": "boolean"
    },
    "environmental_anchors": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "forgotten_threshold_minutes": {
      "default": 30,
      "type": "number"
    },
    "friction_detection_enabled": {
      "default": true,
      "type": "boolean"
    },
    "has_premium": {
      "default": false,
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      },
      "type": "boolean"
    },
    "high_contrast": {
      "default": false,
      "type": "boolean"
    },
    "idle_threshold_minutes": {
      "default": 120,
      "type": "number"
    },
    "laundry_environment": {
      "description": "Legacy field \u2014 superseded by laundry_profile",
      "type": "string"
    },
    "laundry_profile": {
      "default": "private",
      "description": "Adaptive Laundry Profile: private, dorm/apartment, or family",
      "enum": [
        "private",
        "dorm",
        "family"
      ],
      "type": "string"
    },
    "max_idle_time_load_created": {
      "default": 240,
      "type": "number"
    },
    "precise_time_preferences": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "preferred_days_of_week": {
      "items": {
        "type": "number"
      },
      "type": "array"
    },
    "preferred_time_windows": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "reduced_motion": {
      "default": false,
      "type": "boolean"
    },
    "role": {
      "default": "user",
      "enum": [
        "admin",
        "user"
      ],
      "type": "string"
    },
    "roommate_count": {
      "default": 0,
      "description": "Dorm/Apartment profile: number of roommates sharing laundry facilities",
      "type": "number"
    },
    "text_size": {
      "default": "normal",
      "enum": [
        "small",
        "normal",
        "large",
        "xlarge"
      ],
      "type": "string"
    },
    "two_person_household": {
      "default": false,
      "description": "Private profile optional: managing laundry for two people",
      "type": "boolean"
    },
    "voice_commands_enabled": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "laundry_environment",
    "preferred_days_of_week",
    "preferred_time_windows",
    "precise_time_preferences",
    "environmental_anchors",
    "alert_channels"
  ],
  "type": "object"
}