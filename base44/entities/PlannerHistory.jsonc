{
  "name": "PlannerHistory",
  "properties": {
    "current_status": {
      "description": "Status summary at time of generation",
      "type": "string"
    },
    "generated_at": {
      "description": "When this plan was generated",
      "format": "date-time",
      "type": "string"
    },
    "next_action_emoji": {
      "type": "string"
    },
    "next_action_title": {
      "description": "The recommended next action at time of generation",
      "type": "string"
    },
    "outcome": {
      "description": "What the user did with the recommendation",
      "enum": [
        "completed",
        "deferred",
        "skipped"
      ],
      "type": "string"
    }
  },
  "required": [
    "generated_at",
    "next_action_title"
  ],
  "rls": {
    "create": true,
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}